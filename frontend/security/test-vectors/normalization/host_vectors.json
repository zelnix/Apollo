{
  "description": "Host canonicalization vectors shared by every GuardDog implementation. Each expected value is derived from the written rule (HostCanonicalizer.kt header): trim -> strip one trailing dot -> IPv6 (validated, RFC 5952 compressed, bracketed) | IPv4 literal | NFC + lowercase + IDNA punycode; label/length validation. expected null = not a valid host.",
  "rule": "trim; strip ONE trailing dot; IPv6 -> RFC 5952 (lowercase, no leading zeros, longest run of 2+ zero groups compressed, first run on a tie) in brackets; dotted-quad IPv4 kept; otherwise NFC, lowercase, IDNA (punycode), each label [a-z0-9] with inner hyphens, 1-63 chars, whole name <= 253 chars",
  "vectors": [
    { "input": "example.com", "expected": "example.com", "note": "already canonical" },
    { "input": "Example.COM", "expected": "example.com", "note": "lowercase" },
    { "input": "  example.com  ", "expected": "example.com", "note": "trimmed" },
    { "input": "example.com.", "expected": "example.com", "note": "one trailing dot stripped" },
    { "input": "example.com..", "expected": null, "note": "only one trailing dot is stripped; the empty label left is invalid" },
    { "input": "", "expected": null, "note": "empty" },
    { "input": "   ", "expected": null, "note": "blank after trim" },
    { "input": ".", "expected": null, "note": "nothing left after the trailing dot" },
    { "input": "a..b.com", "expected": null, "note": "empty label" },
    { "input": ".example.com", "expected": null, "note": "leading empty label" },
    { "input": "-bad.example", "expected": null, "note": "label starts with a hyphen" },
    { "input": "bad-.example", "expected": null, "note": "label ends with a hyphen" },
    { "input": "under_score.example", "expected": null, "note": "underscore is not a hostname character" },
    { "input": "exa mple.com", "expected": null, "note": "space inside a label" },
    { "input": "ex*ample.com", "expected": null, "note": "symbol inside a label" },
    { "input": "sub-domain.ex-ample.com", "expected": "sub-domain.ex-ample.com", "note": "inner hyphens are valid" },
    { "input": "xn--bcher-kva.example", "expected": "xn--bcher-kva.example", "note": "punycode already" },
    { "input": "bücher.example", "expected": "xn--bcher-kva.example", "note": "IDNA to punycode" },
    { "input": "BÜCHER.example", "expected": "xn--bcher-kva.example", "note": "lowercase, then IDNA" },
    { "input": "bu\u0308cher.example", "expected": "xn--bcher-kva.example", "note": "decomposed u + combining diaeresis: NFC first, then IDNA" },
    { "input": "münchen.de", "expected": "xn--mnchen-3ya.de", "note": "IDNA to punycode" },
    { "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example", "expected": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example", "note": "63-character label is the longest allowed" },
    { "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example", "expected": null, "note": "64-character label is too long" },
    { "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "expected": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "note": "253 characters is the longest allowed name" },
    { "input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "expected": null, "note": "254 characters is too long" },
    { "input": "192.168.0.1", "expected": "192.168.0.1", "note": "IPv4 literal kept as is" },
    { "input": "8.8.8.8.", "expected": "8.8.8.8", "note": "IPv4 literal with its trailing dot stripped" },
    { "input": "[2001:db8::1]", "expected": "[2001:db8::1]", "note": "bracketed IPv6, already canonical" },
    { "input": "2001:db8::1", "expected": "[2001:db8::1]", "note": "bare IPv6 gets brackets" },
    { "input": "2001:0DB8:0000:0000:0000:0000:0000:0001", "expected": "[2001:db8::1]", "note": "RFC 5952: lowercase, no leading zeros, zero run compressed" },
    { "input": "2001:DB8::A", "expected": "[2001:db8::a]", "note": "RFC 5952: lowercase hex" },
    { "input": "2001:db8:0:0:1:0:0:1", "expected": "[2001:db8::1:0:0:1]", "note": "RFC 5952: on a tie the first zero run is compressed" },
    { "input": "2001:db8:0:0:0:1:0:0", "expected": "[2001:db8::1:0:0]", "note": "RFC 5952: the longest zero run is compressed" },
    { "input": "2001:db8:0:1:1:1:1:1", "expected": "[2001:db8:0:1:1:1:1:1]", "note": "RFC 5952: a single zero group is never compressed" },
    { "input": "::1", "expected": "[::1]", "note": "loopback" },
    { "input": "::", "expected": "[::]", "note": "unspecified address" },
    { "input": "1:2:3:4:5:6:7:8:9", "expected": null, "note": "nine groups" },
    { "input": "2001:db8::1::2", "expected": null, "note": "two compressions" },
    { "input": "12345::1", "expected": null, "note": "group longer than four hex digits" },
    { "input": "2001:db8::g", "expected": null, "note": "not hex" },
    { "input": "not:an:ip", "expected": null, "note": "colons alone don't make an IPv6 address" },
    { "input": "[2001:db8::1", "expected": null, "note": "unclosed bracket" }
  ]
}
