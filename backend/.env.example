MONGO_URL=
DB_NAME=

# Guard Dog M1 signing (Ed25519, raw 32-byte seed, base64). Backend-only. Never ship to mobile.
GD_M1_SIGNING_KEY_ID=gd-m1-test-ed25519-001
GD_M1_SIGNING_PRIVATE_KEY_B64=
GD_M1_SECONDARY_KEY_ID=gd-m1-test-ed25519-002
GD_M1_SECONDARY_PRIVATE_KEY_B64=
GD_ADMIN_TOKEN=

# Controlled endpoint (injectable; not production infrastructure)
GD_CONTROLLED_HOST=
GD_CONTROLLED_IPV4=
GD_CONTROLLED_URL=
GD_M1_FROZEN_BUNDLE_VERSION=
GD_RULESET_ID=gd-m1-controlled-block
GD_BUNDLE_TTL_DAYS=30
GD_BLOCK_DEDUPE_WINDOW_MS=5000

# Google Web Risk (optional; provider is disabled when empty)
WEBRISK_API_KEY=
WEBRISK_TIMEOUT_SECONDS=5
GD_PROVIDER_CACHE_TTL_SECONDS=3600

# Signing guard: signing is an administrative/test workflow, never a public API.
# Set GD_SIGNING_ENABLED=false on distribution-only deployments.
GD_SIGNING_ENABLED=true
GD_SIGNING_ALLOWED_RULESETS=gd-m1-controlled-block
